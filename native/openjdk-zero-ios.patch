+// Keep the shared Apple W^X bookkeeping complete for the Zero port too.
+// iOS Zero does not request executable writable pages, but shared VM state
+// transitions still reference this state and these accessors.
+WXMode DefaultWXWriteMode = WXWrite;
+THREAD_LOCAL bool os::_jit_exec_enabled;
+
 void os::current_thread_enable_wx(WXMode mode) {
 #ifndef __IOS__
   pthread_jit_write_protect_np(mode == WXExec);
 #endif
+  _jit_exec_enabled = mode != WXWrite;
+}
+
+bool Thread::wx_enable_write() {
+  if (_wx_state == WXArmedForWrite) {
+    _wx_state = WXWrite;
+    os::current_thread_enable_wx(WXWrite);
+    return true;
+  }
+  return false;
+}
+
+void os::thread_wx_enable_write_impl() {
+  if (!StressWXHealing) {
+    Thread::current()->wx_enable_write();
+  }
 }
 #endif
 
